		<ActiveObjectClass>
			<Id>1772441644721</Id>
			<Name><![CDATA[Main]]></Name>
			<AdditionalClassCode><![CDATA[ParkingLot getRandomParkingLot(ParkingLot... parkingLots) {
    List<ParkingLot> free = new ArrayList<>();
    for (ParkingLot p : parkingLots)
        if (p.nFree() > 0)
            free.add(p);
    return randomFrom(free);
}]]></AdditionalClassCode>
